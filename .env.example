# apps/api
PORT=3000

# Origini autorizzate a chiamare l'API (CORS), separate da virgola
CORS_ORIGINS=http://localhost:5173

# Chiave del service account Firebase, percorso relativo alla radice del monorepo
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Domini ammessi al login, separati da virgola
ALLOWED_EMAIL_DOMAINS=studenti.unipi.it,unipi.it

# Indirizzi ammessi fuori da quei domini, separati da virgola
ALLOWED_EMAILS=utente.test@bacheca.invalid

# Account di prova creato da "npm run utente:test"
TEST_USER_EMAIL=utente.test@bacheca.invalid
TEST_USER_PASSWORD=

# Vite sostituisce le VITE_* a tempo di build.
VITE_API_BASE_URL=http://localhost:3000

# Chiavi delle notifiche push
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
